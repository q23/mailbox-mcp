{
  "name": "imap-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "description": "IMAP MCP Server using Bun runtime with Streamable HTTP transport",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.3.0",
    "imapflow": "^1.1.9",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  }
}
