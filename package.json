{
  "name": "mailbox-mcp",
  "version": "1.1.2",
  "type": "module",
  "description": "Mailbox MCP server for IMAP and SMTP over Streamable HTTP",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "imapflow": "^1.2.18",
    "mailparser": "^3.9.6",
    "nodemailer": "^8.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.11",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "^1.1.13",
    "nodemailer": "^8.0.4",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^2.3.2"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  }
}
