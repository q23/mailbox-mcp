# IMAP Server Configuration (required)
IMAP_HOST=imap.yourserver.com
IMAP_PORT=993
IMAP_TLS=true

# SMTP Server Configuration (optional — enables smtp_send_email and smtp_reply_email)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true

# HTTP Server
PORT=3000
LOG_LEVEL=info

# Encryption Key for AES-256-GCM credential encryption (required)
# Generate with: bun run scripts/encrypt-credentials.ts --generate-key
ENCRYPTION_KEY=

# Connection Pool (optional)
# Maximum number of concurrent IMAP connections (default: 50)
MAX_POOL_SIZE=50

# CORS (optional)
# Restrict to your domain for public deployments; keep * for local Claude Desktop use
ALLOWED_ORIGINS=*
