# IMAP Server Configuration (required)
IMAP_HOST=imap.yourserver.com
IMAP_PORT=993
IMAP_TLS=true

# SMTP Server Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_FROM=

# HTTP Server
PORT=3000
LOG_LEVEL=info

# Encryption Key for AES-256-GCM credential encryption (required)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
