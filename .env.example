# Global IMAP Configuration (shared across all users)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true

# Server
PORT=3000
LOG_LEVEL=info

# Encryption Key for credential encryption (AES-256-GCM)
# Generate with: openssl rand -hex 32
# If not set, a random key will be generated at startup (not recommended for production)
ENCRYPTION_KEY=
